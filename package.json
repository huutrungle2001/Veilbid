{
  "name": "veilbid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "pnpm": "10.33.0"
  },
  "scripts": {
    "build": "pnpm compile && pnpm bindings:check && pnpm --filter @veilbid/chain-bindings --filter @veilbid/operator-console --filter @veilbid/settlement-relay --filter @veilbid/tender-room build",
    "bindings:check": "pnpm --filter @veilbid/auction-house bindings:check",
    "bindings:generate": "pnpm --filter @veilbid/auction-house bindings:generate",
    "compile": "pnpm --filter @veilbid/feasibility --filter @veilbid/auction-house build",
    "finalizer:dry": "pnpm --filter @veilbid/settlement-relay build && node --env-file-if-exists=.env.local settlement-relay/dist/cli.js dry-run",
    "finalizer:health": "pnpm --filter @veilbid/settlement-relay build && node --env-file-if-exists=.env.local settlement-relay/dist/cli.js health",
    "finalizer:once": "pnpm --filter @veilbid/settlement-relay build && node --env-file-if-exists=.env.local settlement-relay/dist/cli.js once",
    "finalizer:poll": "pnpm --filter @veilbid/settlement-relay build && node --env-file-if-exists=.env.local settlement-relay/dist/cli.js poll",
    "lint": "pnpm --filter @veilbid/chain-bindings --filter @veilbid/operator-console --filter @veilbid/settlement-relay --filter @veilbid/tender-room lint",
    "mcp": "pnpm --filter @veilbid/operator-console build && node --env-file-if-exists=.env.local operator-console/dist/mcp-stdio.js",
    "secret:scan": "node feasibility/scripts/scan-repository-secrets.mjs",
    "test": "pnpm --filter @veilbid/feasibility --filter @veilbid/auction-house --filter @veilbid/chain-bindings --filter @veilbid/operator-console --filter @veilbid/settlement-relay --filter @veilbid/tender-room test",
    "test:contracts": "pnpm --filter @veilbid/auction-house test",
    "test:gate-e-static": "pnpm --filter @veilbid/feasibility test:gate-e-static",
    "test:model": "pnpm --filter @veilbid/feasibility test:model",
    "test:nox": "pnpm --filter @veilbid/feasibility test:nox",
    "test:ui": "pnpm --filter @veilbid/tender-room test",
    "test:production": "node tender-room/scripts/smoke-production.mjs",
    "test:sepolia:a": "pnpm --filter @veilbid/feasibility test:sepolia:a",
    "test:sepolia:b": "pnpm --filter @veilbid/feasibility test:sepolia:b",
    "test:sepolia:c": "pnpm --filter @veilbid/feasibility test:sepolia:c",
    "test:sepolia:d": "pnpm --filter @veilbid/feasibility test:sepolia:d",
    "test:sepolia:e:safe": "pnpm --filter @veilbid/feasibility test:sepolia:e:safe",
    "test:sepolia:e:authority": "pnpm --filter @veilbid/feasibility test:sepolia:e:authority",
    "test:sepolia:market:eoa": "pnpm --filter @veilbid/auction-house test:sepolia:eoa",
    "test:sepolia:market:refund": "pnpm --filter @veilbid/auction-house test:sepolia:refund",
    "test:sepolia:market:safe": "pnpm --filter @veilbid/auction-house test:sepolia:safe",
    "test:sepolia:market:safe-viewer": "pnpm --filter @veilbid/auction-house test:sepolia:safe-viewer",
    "test:sepolia:release:two-vendor": "pnpm --filter @veilbid/auction-house test:sepolia:release:two-vendor",
    "preflight:release": "pnpm --filter @veilbid/auction-house preflight:release",
    "deploy:release": "pnpm --filter @veilbid/auction-house deploy:release",
    "publish:sources:release": "pnpm --filter @veilbid/auction-house publish:sources:release",
    "test:preflight": "node --env-file-if-exists=.env.local feasibility/scripts/preflight.mjs",
    "evidence:validate": "node feasibility/scripts/validate-evidence.mjs",
    "verify:deployment": "pnpm --filter @veilbid/auction-house verify:deployment:release",
    "verify:deployment:release": "pnpm --filter @veilbid/auction-house verify:deployment:release",
    "verify:deployment:test": "pnpm --filter @veilbid/auction-house verify:deployment:test"
  }
}
