{
  "name": "@veilbid/feasibility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "hardhat build",
    "test": "node --test test/gate-b-model.test.mjs test/gate-e-static.test.mjs",
    "test:gate-e-static": "node --test test/gate-e-static.test.mjs",
    "test:model": "node --test test/gate-b-model.test.mjs",
    "test:nox": "hardhat test",
    "test:sepolia:a": "node --env-file-if-exists=../.env.local live/gate-a.sepolia.mjs",
    "test:sepolia:b": "node --env-file-if-exists=../.env.local live/gate-b.sepolia.mjs",
    "test:sepolia:c": "node --env-file-if-exists=../.env.local live/gate-c.sepolia.mjs",
    "test:sepolia:d": "node --env-file-if-exists=../.env.local live/gate-d.sepolia.mjs",
    "test:sepolia:e:safe": "node --env-file-if-exists=../.env.local live/gate-e-safe.sepolia.mjs",
    "test:sepolia:e:authority": "node --env-file-if-exists=../.env.local live/gate-e-authority.sepolia.mjs",
    "preflight": "node scripts/preflight.mjs",
    "evidence:validate": "node scripts/validate-evidence.mjs"
  },
  "devDependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-hardhat-plugin": "0.1.0",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.3",
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/protocol-kit": "8.0.4",
    "@types/node": "24.10.1",
    "hardhat": "3.11.1",
    "typescript": "5.9.3",
    "viem": "2.47.6"
  }
}
