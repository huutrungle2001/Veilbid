{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm bindings:build && pnpm --filter @veilbid/settlement-relay build"
  },
  "deploy": {
    "startCommand": "node apps/relay/dist/cli.js poll",
    "healthcheckPath": "/live",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
